{
  "name": "mailzeet-ts",
  "version": "0.1.0-alpha.0",
  "description": "Community TypeScript SDK for the Mailzeet API",
  "author": "Mailzeet Community",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prince0xdev/mailzeet-ts"
  },
  "homepage": "https://github.com/prince0xdev/mailzeet-ts",
  "bugs": {
    "url": "https://github.com/prince0xdev/mailzeet-ts/issues"
  },
  "sideEffects": false,
  "keywords": [
    "mailzeet",
    "email",
    "transactional-email",
    "typescript",
    "nodejs",
    "sdk",
    "api"
  ],
  "dependencies": {
    "mailzeet-ts": "file:mailzeet-ts-0.1.0-alpha.0.tgz"
  }
}
